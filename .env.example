# SkillDost Environment Configuration (Example)
# Copy this to server/.env for local development

PORT=5000
NODE_ENV=development
# If local MongoDB is running, it connects to mongodb://127.0.0.1:27017/skilldost
# If left empty or connection fails, the server automatically starts mongodb-memory-server
MONGODB_URI=mongodb://127.0.0.1:27017/skilldost

# Secret key for signing JWT tokens (httpOnly cookie auth)
JWT_SECRET=skilldost_prototype_development_jwt_secret_token_12345

# Allowed frontend origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
